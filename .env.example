# Copy to .env for local dev only. On Render, set these in Dashboard > Environment.
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require&channel_binding=require
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/birthday_app?retryWrites=true&w=majority
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_USERNAME=Chinni_Admin
ADMIN_PASSWORD=
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAILS=
PYTHON_VERSION=3.12.8
# Optional
APP_ENV=production
APP_TIMEZONE=Asia/Kolkata
MAX_UPLOAD_MB=30
