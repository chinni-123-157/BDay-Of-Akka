# Neon (PostgreSQL) connection string from Neon dashboard
DATABASE_URL=postgresql://user:password@ep-example.aws.neon.tech/neondb?sslmode=require

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=birthday_site

# SMTP details. Allowed recipients are kept in data/approved_recipients.json.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=app-password
SMTP_FROM=your-email@example.com
SECRET_KEY=change-me
